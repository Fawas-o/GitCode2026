{
  "name": "Python Codespace",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "postCreateCommand": "python -m pip install --upgrade pip && pip install -r requirements.txt",
  "forwardPorts": [8888],
  "remoteUser": "vscode"
}
